# 运行配置默认不入库；仅允许插件内置资源模板
*.json
!tshock/PlayerReward/PlayerReward.json
!tshock/CustomPlayer/源码/CustomPlayer.CustomPlayer.json
# 插件清单：上游 UnrealMultiple 规范的一部分，属于源码而非运行配置
!tshock/**/manifest.json
!tsl/**/manifest.json
# i18n 源文件：.po/.pot 是翻译源，.mo 才是编译产物
!tshock/**/i18n/*.po
!tshock/**/i18n/*.pot
!tsl/**/i18n/*.po
!tsl/**/i18n/*.pot
# 配置模板：plugins 目录下的 config/ 放的是可复用的默认配置，不含凭据与运行数据
!tshock/**/config/*.json
!tsl/**/config/*.json
