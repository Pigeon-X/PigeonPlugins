<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <AssemblyName>CommandTool.Tests</AssemblyName><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UtBase Condition="'$(UtBase)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..\_参考资料\官方源码\UnifierTSL更新\已完成\0.3.1-tshock6.1-cn\utsl-win-x64</UtBase>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CommandTool.UnifierTSL.csproj" AdditionalProperties="UtBase=$(UtBase)" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(UtBase)\lib\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="UnifierTSL"><HintPath>$(UtBase)\lib\UnifierTSL.dll</HintPath></Reference>
    <Reference Include="OTAPI"><HintPath>$(UtBase)\lib\OTAPI.dll</HintPath></Reference>
    <Reference Include="OTAPI.Runtime"><HintPath>$(UtBase)\lib\OTAPI.Runtime.dll</HintPath></Reference>
    <Reference Include="TShockAPI"><HintPath>$(UtBase)\plugins\TShockAPI.dll</HintPath></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(UtBase)\lib\MonoMod.RuntimeDetour.dll</HintPath></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(UtBase)\lib\MonoMod.Utils.dll</HintPath></Reference>
    <Content Include="$(UtBase)\lib\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
