<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>CustomPlayer</AssemblyName>
    <RootNamespace />
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <OutputPath>..\..\publish\BuildOutput\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TShockRoot Condition="'$(TShockRoot)' == ''">D:\59934\Desktop\TShock6.2.1一键部署包\payload</TShockRoot>
    <NuGetRoot Condition="'$(NuGetRoot)' == ''">C:\Users\59934\.nuget\packages</NuGetRoot>
    <NoWarn>$(NoWarn);CS0162;CS0219;CS0618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TShockAPI"><HintPath>$(TShockRoot)\ServerPlugins\TShockAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OTAPI"><HintPath>$(TShockRoot)\bin\OTAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OTAPI.Runtime"><HintPath>$(TShockRoot)\bin\OTAPI.Runtime.dll</HintPath><Private>false</Private></Reference>
