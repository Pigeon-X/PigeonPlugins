    <Reference Include="MySql.Data"><HintPath>$(NuGetRoot)\mysql.data\9.1.0\lib\netstandard2.0\MySql.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(NuGetRoot)\newtonsoft.json\13.0.3\lib\netstandard2.0\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
