{
    // ============================================================
    //  CustomPlayer 配置文件（中文说明版）
    //  为兼容网站、其他插件和历史数据，所有键名保持英文原名不变，
    //  这里用注释补充中文说明。本文件支持 // 注释，请勿删除键名。
    // ============================================================

    "Commands": {
        "Use": {
            // 普通玩家指令名（默认 /bear）
            "Names": [ "bear" ],
            // 普通玩家指令所需权限（留空 = 人人可用）
            "Permissions": "custom.use"
        },
        "Admin": {
            // 管理指令名（默认 /custom）
            "Names": [ "custom" ],
            // 管理指令所需权限
            "Permissions": "custom.admin"
        }
    },

    // ---------------- 数据库 ----------------
    // 本服编号：主城与各小服填不同数字(1/2/3...)。佩戴的前后缀按服分别保存，互不干扰。
    "ServerId": 0,

    // 数据库类型：
    //   "Mysql"  = 用下面的 Mysql* 参数连接独立数据库（网站/多服共用同一份数据，默认）
    //   "TShock" = 直接使用 TShock 自身的数据库（TShock 用 SQLite/MySQL/PostgreSQL 都能跑）
    "DatabaseType": "Mysql",

    "MysqlHost": "127.0.0.1",
    "MysqlPort": 3306,
    "MysqlDatabase": "Custom",
    "MysqlUser": "root",
    // 【重要】默认弱口令极易被扫描爆破，请务必改成强密码！
    "MysqlPass": "CHANGE_ME",

    // ---------------- 功能开关 ----------------
    // 调试模式：true 时后台会打印数据库/称号等调试日志，正式服保持 false 即可
    "Debug": false,
    // 是否启用附加用户组（/custom GroupCtl 系列）
    "EnableGroup": true,
    // 是否启用前缀功能（/bear Prefix ...）
    "EnablePrefix": true,
    // 是否启用后缀功能（/bear Suffix ...）
    "EnableSuffix": true,
    // 是否启用权限赠送功能（/custom Permission ...）
    "EnablePermission": true,
    // 附加组是否覆盖玩家原本的用户组（取等级最高的组）
    "CoverGroup": true,

    // ---------------- 称号插件对接 ----------------
    // 称号插件(Chrome.Title)已合并进本插件同一个 dll，这里控制是否启用：
    //   true  = 前缀/后缀/颜色交给称号插件渲染，可用 /称号、/改称号 指令与聊天气泡
    //   false = 用 CustomPlayer 自带的聊天格式渲染前后缀（默认）
    "对接称号插件": false
}