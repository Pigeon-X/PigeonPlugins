<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>BoundaryTransfer.Tests</AssemblyName>
    <RootNamespace>BoundaryTransfer.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <UtBase Condition="'$(UtBase)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..\_参考资料\官方源码\UnifierTSL更新\已完成\0.3.1-tshock6.1-cn\utsl-win-x64</UtBase>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BoundaryTransfer.UnifierTSL.csproj" AdditionalProperties="UtBase=$(UtBase)" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(UtBase)\lib\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnifierTSL"><HintPath>$(UtBase)\lib\UnifierTSL.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="OTAPI"><HintPath>$(UtBase)\lib\OTAPI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="OTAPI.Runtime"><HintPath>$(UtBase)\lib\OTAPI.Runtime.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TShockAPI"><HintPath>$(UtBase)\plugins\TShockAPI.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 真实基线运行依赖原样复制，不下载第三方 NuGet 测试框架。 -->
    <Content Include="$(UtBase)\lib\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
